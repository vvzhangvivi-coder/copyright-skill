# ============================================================
# 著作权登记自动填表 — 环境变量配置
# 复制此文件为 .env 并填入你的实际值
# ============================================================

# 飞书多维表格（包含待登记作品数据的表格）
# 也可通过 /api/config 动态设置，此处为默认值
BITABLE_BASE_TOKEN=your_base_token_here
BITABLE_TABLE_ID=your_table_id_here

# 本地服务端口
BOT_PORT=3456
